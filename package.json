{
  "name": "zotero-agent-client",
  "type": "module",
  "version": "0.1.0",
  "description": "Connect Zotero to local ACP agents from the reader sidebar.",
  "config": {
    "addonName": "Zotero Agent Client",
    "addonID": "zotero-agent-client@example.com",
    "addonRef": "agentclient",
    "addonInstance": "ZoteroAgentClient",
    "prefsPrefix": "extensions.zotero.agentclient"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/zotero-agent-client.git"
  },
  "author": "Zotero Agent Client contributors",
  "bugs": {
    "url": "https://github.com/local/zotero-agent-client/issues"
  },
  "homepage": "https://github.com/local/zotero-agent-client#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "markdown-it": "^14.1.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
